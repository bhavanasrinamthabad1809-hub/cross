[sub_resource type="GDScript" id="GDScript_hx3la"]
script/source = "extends CharacterBody2D

enum CowState {
	WANDERING,
	HIDING,
	FOUND,
	FOLLOWING,
	IN_SHED
}

@export var speed := 80.0
@export var player: Node2D
@export var hide_spots: Array[Marker2D]

var state = CowState.WANDERING
var current_hide_spot: Marker2D


func _physics_process(delta):
	match state:

		CowState.WANDERING:
			wander()

		CowState.HIDING:
			hide()

		CowState.FOUND:
			stop_moving()

		CowState.FOLLOWING:
			follow_player()

		CowState.IN_SHED:
			stop_moving()


func wander():
	if hide_spots.is_empty():
		return

	# Pick a random hiding place
	current_hide_spot = hide_spots.pick_random()
	state = CowState.HIDING


func hide():
	if current_hide_spot == null:
		return

	var direction = global_position.direction_to(
		current_hide_spot.global_position
	)

	velocity = direction * speed
	move_and_slide()

	# Check if cow reached hiding place
	if global_position.distance_to(current_hide_spot.global_position) < 5:
		velocity = Vector2.ZERO


func follow_player():
	if player == null:
		return

	var direction = global_position.direction_to(
		player.global_position
	)

	velocity = direction * speed
	move_and_slide()


func stop_moving():
	velocity = Vector2.ZERO


func found():
	state = CowState.FOLLOWING


func enter_shed():
	state = CowState.IN_SHED
"

